---
import '../styles/global.css';
import { LOCALES, t, type Locale } from '../i18n';

interface Props {
  title: string;
  description?: string;
  lang?: Locale;
  /** Href of each translation of the current page, or null when none exists. */
  hrefs?: Record<Locale, string | null>;
}

const { title, description, lang = 'en', hrefs } = Astro.props;
const labels = t(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const home = `${base}/${lang}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description ?? labels.metaDescription} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        let stored = null;
        try { stored = localStorage.getItem('theme'); } catch {}
        const param = new URLSearchParams(window.location.search).get('scoutTheme');
        const theme =
          param || stored || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#content">{labels.skipToContent}</a>
    <header class="site-header">
      <div class="frame">
        <a class="brand" href={home}><span>/</span>cmaneu <span>recipes</span></a>
        <nav class="site-nav" aria-label={labels.mainNav}>
          <a href={`${home}#recipes`}>{labels.navRecipes}</a>
          <a href="https://www.maneu.net/">maneu.net ↗</a>
        </nav>
        <div class="header-tools">
          <nav class="lang-links" aria-label={labels.switchLanguage}>
            {
              LOCALES.map((locale) => {
                const href = hrefs?.[locale] ?? (locale === lang ? home : null);
                return href ? (
                  <a href={href} hreflang={locale} lang={locale} aria-current={locale === lang ? 'true' : undefined}>
                    {locale.toUpperCase()}
                  </a>
                ) : (
                  <span class="lang-unavailable" title={labels.noTranslation}>{locale.toUpperCase()}</span>
                );
              })
            }
          </nav>
          <button type="button" data-theme-toggle aria-label={labels.toggleTheme}>◐</button>
        </div>
      </div>
    </header>
    <main id="content" tabindex="-1"><slot /></main>
    <footer class="site-footer">
      <div class="frame">
        <span>{labels.footerAbout}</span>
        <a href="https://github.com/cmaneu/recipes">{labels.footerGitHub}</a>
      </div>
    </footer>
    <script>
      document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
        const root = document.documentElement;
        const theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = theme;
        try {
          localStorage.setItem('theme', theme);
        } catch {}
      });
    </script>
  </body>
</html>
