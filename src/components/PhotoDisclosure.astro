---
interface Props {
  text: string;
}

const { text } = Astro.props;
---

<aside class="photo-disclosure" role="note">
  <span class="photo-disclosure-mark" aria-hidden="true">
    <svg viewBox="0 0 32 32" fill="none">
      <rect x="4.5" y="7.5" width="18" height="17" rx="3" stroke="currentColor" stroke-width="1.8" />
      <circle cx="10.5" cy="13" r="1.8" fill="currentColor" />
      <path d="m6 22 5-5 3.5 3 2.5-2 4 4" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" />
      <path d="m24.5 5 .9 2.6L28 8.5l-2.6.9-.9 2.6-.9-2.6-2.6-.9 2.6-.9.9-2.6Z" fill="currentColor" />
    </svg>
  </span>
  <span>{text}</span>
</aside>
